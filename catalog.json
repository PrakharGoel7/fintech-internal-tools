          "claimAction": {
            "type": "string",
            "description": "Action that assigns the item to the current user"
          },
          "decisionActions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "summaryFields": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string"
