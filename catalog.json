  "blocks": [
    {
      "name": "data-grid",
      "version": "1.0.0",
      "category": "data",
      "summary": "Searchable, filterable table over a data source with row actions and audited CSV export.",
      "useWhen": [
        "Browsing or searching a list of records",
        "Running an action on individual rows",
        "Exporting data for analysis"
      ],
      "notFor": [
        "Work that must be claimed and decided one item at a time (use review-queue)",
        "Boolean config grids (use toggle-matrix)"
      ],
      "requires": [
        "rbac",
        "pii-masking",
        "audit"
      ],
      "emitsAudit": [
        "data.exported",
        "action.<id>"
      ],
      "permissions": [
        "view",
        "export"
      ],
      "example": {
        "source": "refunds",
        "columns": [
          "id",
          "customer_name",
          {
            "field": "amount",
            "format": "currency"
          },
          "status"
        ],
        "filters": [
          {
            "field": "status",
            "options": [
              "requested",
              "issued",
              "denied"
            ]
          }
        ],
        "rowActions": [
          "issueRefund"
        ],
        "rowLink": "refunds/:id",
        "exportable": true
      },
      "usedBy": [
        "kyc-review",
        "refunds",
        "chargeback-disputes",
        "aml-alerts"
      ],
      "configSchema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "description": "Data source name (see connectors)"
          },
          "columns": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "format": {
                      "type": "string",
                      "enum": [
                        "text",
                        "number",
                        "currency",
                        "date",
                        "datetime",
                        "relative",
                        "status",
                        "boolean",
                        "percent"
                      ]
                    }
                  },
                  "required": [
                    "field"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "minItems": 1
          },
          "where": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "op": {
                  "type": "string",
                  "enum": [
                    "eq",
                    "neq",
                    "gt",
                    "gte",
                    "lt",
                    "lte",
                    "in",
                    "notIn"
                  ]
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": [
                          "string",
                          "number"
                        ]
                      }
                    }
                  ]
                }
              },
              "required": [
                "field",
                "op",
                "value"
              ],
              "additionalProperties": false
            },
            "description": "Static filter always applied"
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "field",
                "options"
              ],
              "additionalProperties": false
            },
            "default": []
          },
          "searchable": {
            "type": "boolean",
            "default": true
          },
          "rowActions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Action ids from app.actions"
          },
          "rowLink": {
            "type": "string",
            "description": "Page path pattern, e.g. \"refunds/:id\""
          },
          "pageSize": {
            "type": "integer",
            "minimum": 5,
            "maximum": 200,
            "default": 25
          },
          "exportable": {
            "type": "boolean",
            "default": false,
            "description": "CSV export (requires the 'export' permission; audited)"
          }
        },
        "required": [
          "source",
          "columns"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
