    {
      "name": "metric-cards",
      "version": "1.0.0",
      "category": "insight",
      "summary": "Row of KPI cards computed from a data source (count/sum/avg with filters).",
      "useWhen": [
        "Headline numbers at the top of a dashboard or queue"
      ],
      "notFor": [
