    {
      "name": "review-queue",
      "version": "2.0.0",
      "category": "workflow",
      "summary": "Claimable work queue with SLA timers or hard-deadline countdowns, assignment, detail panel, decisions, comments and per-item audit history.",
      "useWhen": [
        "Humans process items one at a time and record a decision (KYC, disputes, fraud alerts, content review)",
        "Work needs ownership and SLA tracking",
        "Items have an external hard deadline (sla.mode = deadline)"
      ],
      "notFor": [
        "Read-only browsing (use data-grid)",
        "Bulk configuration (use toggle-matrix)"
      ],
      "requires": [
        "rbac",
        "pii-masking",
        "audit",
        "maker-checker"
      ],
      "emitsAudit": [
        "action.<claim>",
        "action.<decision>",
        "approval.requested",
        "comment.added",
        "pii.revealed"
      ],
      "permissions": [
        "view",
        "pii.reveal",
        "comment"
      ],
      "example": {
        "source": "kyc_cases",
        "openWhere": [
          {
            "field": "status",
            "op": "in",
            "value": [
              "pending",
              "in_review"
            ]
          }
        ],
        "claimAction": "claim",
        "decisionActions": [
          "approve",
          "reject",
          "escalate"
        ],
        "summaryFields": [
          "customer_name",
          "country",
          "risk_score"
        ],
        "detailFields": [
          "customer_name",
          "email",
          "ssn_last4",
          "dob",
          "doc_type",
          "vendor_result"
        ],
        "sla": {
          "field": "created_at",
          "hours": 48
        },
        "badges": [
          {
            "when": [
              {
                "field": "risk_score",
                "op": "gt",
                "value": 70
              }
            ],
            "label": "High risk",
            "tone": "bad"
          }
        ]
      },
      "usedBy": [
        "kyc-review",
        "chargeback-disputes",
        "aml-alerts"
      ],
      "configSchema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
