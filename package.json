{
  "name": "fintech-internal-tools",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts tests",
    "seed": "tsx scripts/seed.ts",
    "tamper-demo": "tsx scripts/tamper-demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "catalog": "tsx scripts/catalog.ts",
