    "boundaries": "tsx scripts/check-boundaries.ts",
    "check": "npm run typecheck && npm run lint && npm run boundaries && npm run validate-apps && npm run catalog -- --check && npm test"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
